# Copy to .env and fill in. .env is git-ignored; never commit real values.

# LLM used for discovery runs only (replay never calls a model).
# Provider: anthropic (default) or gemini. Fill in the key for the one you use.
CUA_LLM_PROVIDER=anthropic
# Leave empty for the provider default (claude-sonnet-5-5 / gemini-3.8-flash).
CUA_MODEL=

ANTHROPIC_API_KEY=
# Only needed if your Anthropic key is not scoped to a workspace (Console -> Settings -> Workspaces).
ANTHROPIC_WORKSPACE_ID=

GEMINI_API_KEY=

# Service account for the local MockCore target app. MockCore is fictional and local-only;
# these are its built-in demo credentials, not real secrets.
MOCKCORE_USERNAME=svc-cua
MOCKCORE_PASSWORD=mockcore-demo
