# Copy to .env and fill in. .env is git-ignored; never commit real values.

# LLM used for discovery runs only (replay never calls the model).
ANTHROPIC_API_KEY=
# Only needed if your key is not scoped to a workspace (Console -> Settings -> Workspaces).
ANTHROPIC_WORKSPACE_ID=
CUA_MODEL=claude-sonnet-5-5

# Service account for the local MockCore target app. MockCore is fictional and local-only;
# these are its built-in demo credentials, not real secrets.
MOCKCORE_USERNAME=svc-cua
MOCKCORE_PASSWORD=mockcore-demo
