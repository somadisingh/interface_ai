{
  "$defs": {
    "AllOf": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "all",
          "default": "all",
          "title": "Kind",
          "type": "string"
        },
        "conditions": {
          "items": {
            "discriminator": {
              "mapping": {
                "all": "#/$defs/AllOf",
                "any": "#/$defs/AnyOf",
                "hidden": "#/$defs/Hidden",
                "output": "#/$defs/OutputPresent",
                "text": "#/$defs/TextMatches",
                "url": "#/$defs/UrlMatches",
                "visible": "#/$defs/Visible"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/Visible"
              },
              {
                "$ref": "#/$defs/Hidden"
              },
              {
                "$ref": "#/$defs/TextMatches"
              },
              {
                "$ref": "#/$defs/UrlMatches"
              },
              {
                "$ref": "#/$defs/OutputPresent"
              },
              {
                "$ref": "#/$defs/AllOf"
              },
              {
                "$ref": "#/$defs/AnyOf"
              }
            ]
          },
          "minItems": 1,
          "title": "Conditions",
          "type": "array"
        }
      },
      "required": [
        "conditions"
      ],
      "title": "AllOf",
      "type": "object"
    },
    "AnchorLocator": {
      "additionalProperties": false,
      "description": "A control positioned relative to visible anchor text, for when the label is only\nvisually adjacent and not programmatically associated (common in legacy UIs).\n\n``same_row`` means the innermost table row that contains a cell whose text is exactly\n``anchor_text``. ``role`` narrows the control type inside that row, e.g. ``textbox``.\n(Other spatial relations are deliberately not modelled until a target needs them.)",
      "properties": {
        "strategy": {
          "const": "anchor",
          "default": "anchor",
          "title": "Strategy",
          "type": "string"
        },
        "anchor_text": {
          "title": "Anchor Text",
          "type": "string"
        },
        "relation": {
          "const": "same_row",
          "default": "same_row",
          "title": "Relation",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        }
      },
      "required": [
        "anchor_text"
      ],
      "title": "AnchorLocator",
      "type": "object"
    },
    "AnyOf": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "any",
          "default": "any",
          "title": "Kind",
          "type": "string"
        },
        "conditions": {
          "items": {
            "discriminator": {
              "mapping": {
                "all": "#/$defs/AllOf",
                "any": "#/$defs/AnyOf",
                "hidden": "#/$defs/Hidden",
                "output": "#/$defs/OutputPresent",
                "text": "#/$defs/TextMatches",
                "url": "#/$defs/UrlMatches",
                "visible": "#/$defs/Visible"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/Visible"
              },
              {
                "$ref": "#/$defs/Hidden"
              },
              {
                "$ref": "#/$defs/TextMatches"
              },
              {
                "$ref": "#/$defs/UrlMatches"
              },
              {
                "$ref": "#/$defs/OutputPresent"
              },
              {
                "$ref": "#/$defs/AllOf"
              },
              {
                "$ref": "#/$defs/AnyOf"
              }
            ]
          },
          "minItems": 1,
          "title": "Conditions",
          "type": "array"
        }
      },
      "required": [
        "conditions"
      ],
      "title": "AnyOf",
      "type": "object"
    },
    "AttributeLocator": {
      "additionalProperties": false,
      "description": "Web-only: an element by tag and a stable attribute, e.g. ``input[name=mid]``.",
      "properties": {
        "strategy": {
          "const": "attribute",
          "default": "attribute",
          "title": "Strategy",
          "type": "string"
        },
        "tag": {
          "title": "Tag",
          "type": "string"
        },
        "attribute": {
          "title": "Attribute",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "tag",
        "attribute",
        "value"
      ],
      "title": "AttributeLocator",
      "type": "object"
    },
    "Check": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "check",
          "default": "check",
          "title": "Type",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "checked": {
          "default": true,
          "title": "Checked",
          "type": "boolean"
        }
      },
      "required": [
        "target"
      ],
      "title": "Check",
      "type": "object"
    },
    "Click": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "click",
          "default": "click",
          "title": "Type",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "target"
      ],
      "title": "Click",
      "type": "object"
    },
    "CssLocator": {
      "additionalProperties": false,
      "description": "Web-only last resort: a structural CSS selector. Recorded, but inherently fragile.",
      "properties": {
        "strategy": {
          "const": "css",
          "default": "css",
          "title": "Strategy",
          "type": "string"
        },
        "selector": {
          "title": "Selector",
          "type": "string"
        }
      },
      "required": [
        "selector"
      ],
      "title": "CssLocator",
      "type": "object"
    },
    "Extract": {
      "additionalProperties": false,
      "description": "Read the text of a target into a declared output, parsed as ``parse``.\n\n``pattern``, if given, is a regex whose first group selects the part of the text to keep.",
      "properties": {
        "type": {
          "const": "extract",
          "default": "extract",
          "title": "Type",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "into": {
          "title": "Into",
          "type": "string"
        },
        "parse": {
          "default": "text",
          "enum": [
            "text",
            "money",
            "integer",
            "decimal",
            "date"
          ],
          "title": "Parse",
          "type": "string"
        },
        "pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pattern"
        }
      },
      "required": [
        "target",
        "into"
      ],
      "title": "Extract",
      "type": "object"
    },
    "Fill": {
      "additionalProperties": false,
      "description": "Replace the content of a text control with ``value`` (template allowed).",
      "properties": {
        "type": {
          "const": "fill",
          "default": "fill",
          "title": "Type",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "target",
        "value"
      ],
      "title": "Fill",
      "type": "object"
    },
    "FrameRef": {
      "additionalProperties": false,
      "description": "One hop in a frame path (frameset ``<frame>`` or ``<iframe>``), by name or URL.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "url_pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url Pattern"
        }
      },
      "title": "FrameRef",
      "type": "object"
    },
    "Handler": {
      "additionalProperties": false,
      "description": "How to get past a recoverable state.\n\n``then`` says how to continue afterwards:\n\n* ``resume`` \u2014 continue the current step: re-check its checkpoint, and perform its\n  action again **only if the action never completed** (e.g. an overlay intercepted the\n  click). An action that did complete is never repeated, so a recovery can't cause a\n  double submission.\n* ``restart_capability`` \u2014 start the flow over (e.g. after re-signing on, the page\n  context is gone). Only allowed while no irreversible step has executed in this run;\n  otherwise the run stops with ``SESSION_UNRECOVERABLE``.",
      "properties": {
        "actions": {
          "items": {
            "discriminator": {
              "mapping": {
                "check": "#/$defs/Check",
                "click": "#/$defs/Click",
                "extract": "#/$defs/Extract",
                "fill": "#/$defs/Fill",
                "navigate": "#/$defs/Navigate",
                "press": "#/$defs/Press",
                "select": "#/$defs/Select"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/Click"
              },
              {
                "$ref": "#/$defs/Fill"
              },
              {
                "$ref": "#/$defs/Select"
              },
              {
                "$ref": "#/$defs/Check"
              },
              {
                "$ref": "#/$defs/Press"
              },
              {
                "$ref": "#/$defs/Navigate"
              },
              {
                "$ref": "#/$defs/Extract"
              }
            ]
          },
          "title": "Actions",
          "type": "array"
        },
        "run_capability": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Capability"
        },
        "then": {
          "enum": [
            "resume",
            "restart_capability"
          ],
          "title": "Then",
          "type": "string"
        }
      },
      "required": [
        "then"
      ],
      "title": "Handler",
      "type": "object"
    },
    "Hidden": {
      "additionalProperties": false,
      "description": "The target resolves to no visible element.",
      "properties": {
        "kind": {
          "const": "hidden",
          "default": "hidden",
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "target"
      ],
      "title": "Hidden",
      "type": "object"
    },
    "KnownState": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "kind": {
          "enum": [
            "interstitial",
            "session_expired",
            "business_outcome",
            "failure"
          ],
          "title": "Kind",
          "type": "string"
        },
        "detect": {
          "discriminator": {
            "mapping": {
              "all": "#/$defs/AllOf",
              "any": "#/$defs/AnyOf",
              "hidden": "#/$defs/Hidden",
              "output": "#/$defs/OutputPresent",
              "text": "#/$defs/TextMatches",
              "url": "#/$defs/UrlMatches",
              "visible": "#/$defs/Visible"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Visible"
            },
            {
              "$ref": "#/$defs/Hidden"
            },
            {
              "$ref": "#/$defs/TextMatches"
            },
            {
              "$ref": "#/$defs/UrlMatches"
            },
            {
              "$ref": "#/$defs/OutputPresent"
            },
            {
              "$ref": "#/$defs/AllOf"
            },
            {
              "$ref": "#/$defs/AnyOf"
            }
          ],
          "title": "Detect"
        },
        "handler": {
          "anyOf": [
            {
              "$ref": "#/$defs/Handler"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outcome": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "failure_category": {
          "anyOf": [
            {
              "enum": [
                "INVALID_INPUT",
                "POLICY_VIOLATION",
                "LOCATOR_NOT_FOUND",
                "LOCATOR_AMBIGUOUS",
                "CHECKPOINT_FAILED",
                "UNKNOWN_STATE",
                "APP_ERROR",
                "TIMEOUT",
                "SESSION_UNRECOVERABLE",
                "RECOVERY_EXHAUSTED",
                "APPROVAL_DENIED",
                "HUMAN_ABORTED",
                "CONFIGURATION_ERROR"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Category"
        }
      },
      "required": [
        "description",
        "kind",
        "detect"
      ],
      "title": "KnownState",
      "type": "object"
    },
    "LabelLocator": {
      "additionalProperties": false,
      "description": "The control whose accessible label is ``text`` (``<label>``, aria-label, title).",
      "properties": {
        "strategy": {
          "const": "label",
          "default": "label",
          "title": "Strategy",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "exact": {
          "default": true,
          "title": "Exact",
          "type": "boolean"
        }
      },
      "required": [
        "text"
      ],
      "title": "LabelLocator",
      "type": "object"
    },
    "Navigate": {
      "additionalProperties": false,
      "description": "Go to a path relative to the app instance's base URL (template allowed).\n\nPaths are relative on purpose: the same artifact runs against every tenant's instance of\nthe app; the base URL is runtime configuration, not part of the flow.",
      "properties": {
        "type": {
          "const": "navigate",
          "default": "navigate",
          "title": "Type",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "Navigate",
      "type": "object"
    },
    "OutputPresent": {
      "additionalProperties": false,
      "description": "A declared output was extracted and is non-empty.",
      "properties": {
        "kind": {
          "const": "output",
          "default": "output",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "OutputPresent",
      "type": "object"
    },
    "Press": {
      "additionalProperties": false,
      "description": "Press a key, optionally with focus on a target (e.g. ``Enter`` in a field).",
      "properties": {
        "type": {
          "const": "press",
          "default": "press",
          "title": "Type",
          "type": "string"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        }
      },
      "required": [
        "key"
      ],
      "title": "Press",
      "type": "object"
    },
    "RoleLocator": {
      "additionalProperties": false,
      "description": "Accessible role + accessible name, e.g. button \"Sign On\", link \"Member Search\".",
      "properties": {
        "strategy": {
          "const": "role",
          "default": "role",
          "title": "Strategy",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "exact": {
          "default": true,
          "title": "Exact",
          "type": "boolean"
        }
      },
      "required": [
        "role"
      ],
      "title": "RoleLocator",
      "type": "object"
    },
    "Select": {
      "additionalProperties": false,
      "description": "Choose an option in a dropdown by its visible label or value (template allowed).",
      "properties": {
        "type": {
          "const": "select",
          "default": "select",
          "title": "Type",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "option": {
          "title": "Option",
          "type": "string"
        }
      },
      "required": [
        "target",
        "option"
      ],
      "title": "Select",
      "type": "object"
    },
    "SessionConfig": {
      "additionalProperties": false,
      "properties": {
        "sign_on_capability": {
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "title": "Sign On Capability",
          "type": "string"
        }
      },
      "required": [
        "sign_on_capability"
      ],
      "title": "SessionConfig",
      "type": "object"
    },
    "TableCellLocator": {
      "additionalProperties": false,
      "description": "A cell addressed like a human reads a grid: the row containing ``row_text``, in the\ncolumn headed ``column_header``.",
      "properties": {
        "strategy": {
          "const": "table_cell",
          "default": "table_cell",
          "title": "Strategy",
          "type": "string"
        },
        "row_text": {
          "title": "Row Text",
          "type": "string"
        },
        "column_header": {
          "title": "Column Header",
          "type": "string"
        }
      },
      "required": [
        "row_text",
        "column_header"
      ],
      "title": "TableCellLocator",
      "type": "object"
    },
    "TargetSpec": {
      "additionalProperties": false,
      "description": "A named element/control the flow interacts with or reads from.",
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "frame": {
          "items": {
            "$ref": "#/$defs/FrameRef"
          },
          "title": "Frame",
          "type": "array"
        },
        "locators": {
          "items": {
            "discriminator": {
              "mapping": {
                "anchor": "#/$defs/AnchorLocator",
                "attribute": "#/$defs/AttributeLocator",
                "css": "#/$defs/CssLocator",
                "label": "#/$defs/LabelLocator",
                "role": "#/$defs/RoleLocator",
                "table_cell": "#/$defs/TableCellLocator",
                "text": "#/$defs/TextLocator"
              },
              "propertyName": "strategy"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/RoleLocator"
              },
              {
                "$ref": "#/$defs/LabelLocator"
              },
              {
                "$ref": "#/$defs/AnchorLocator"
              },
              {
                "$ref": "#/$defs/TableCellLocator"
              },
              {
                "$ref": "#/$defs/TextLocator"
              },
              {
                "$ref": "#/$defs/AttributeLocator"
              },
              {
                "$ref": "#/$defs/CssLocator"
              }
            ]
          },
          "minItems": 1,
          "title": "Locators",
          "type": "array"
        },
        "robustness_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Robustness Note"
        },
        "sensitive": {
          "default": false,
          "title": "Sensitive",
          "type": "boolean"
        }
      },
      "required": [
        "description",
        "locators"
      ],
      "title": "TargetSpec",
      "type": "object"
    },
    "TextLocator": {
      "additionalProperties": false,
      "description": "An element by its visible text (e.g. a ``<span onclick>`` \"button\").",
      "properties": {
        "strategy": {
          "const": "text",
          "default": "text",
          "title": "Strategy",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "exact": {
          "default": true,
          "title": "Exact",
          "type": "boolean"
        }
      },
      "required": [
        "text"
      ],
      "title": "TextLocator",
      "type": "object"
    },
    "TextMatches": {
      "additionalProperties": false,
      "description": "Visible text matching the regular expression ``pattern`` is present.",
      "properties": {
        "kind": {
          "const": "text",
          "default": "text",
          "title": "Kind",
          "type": "string"
        },
        "pattern": {
          "title": "Pattern",
          "type": "string"
        },
        "frame": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/FrameRef"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame"
        }
      },
      "required": [
        "pattern"
      ],
      "title": "TextMatches",
      "type": "object"
    },
    "UrlMatches": {
      "additionalProperties": false,
      "description": "The document URL (of the given frame, or the top page) matches ``pattern``.",
      "properties": {
        "kind": {
          "const": "url",
          "default": "url",
          "title": "Kind",
          "type": "string"
        },
        "pattern": {
          "title": "Pattern",
          "type": "string"
        },
        "frame": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/FrameRef"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame"
        }
      },
      "required": [
        "pattern"
      ],
      "title": "UrlMatches",
      "type": "object"
    },
    "Visible": {
      "additionalProperties": false,
      "description": "The target resolves to exactly one visible element.",
      "properties": {
        "kind": {
          "const": "visible",
          "default": "visible",
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "target"
      ],
      "title": "Visible",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "product": {
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Product",
      "type": "string"
    },
